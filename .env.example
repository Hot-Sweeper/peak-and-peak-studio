# Peak Studio environment variables
# Copy this file to .env.local for local development.

# Railway sets PORT automatically. Next.js respects it out of the box.
# PORT=3000

# ── Library transfer ──
# Where shared libraries are stored. Defaults to <RAILWAY_VOLUME_MOUNT_PATH>/peak-shares
# when a Railway volume is attached, otherwise to the system temp folder.
# SHARE_STORAGE_DIR=/data/peak-shares

# Largest single song accepted, in MB (default 500).
# SHARE_MAX_TRACK_MB=500

# Largest library accepted per share, in MB (default 20480 = 20 GB).
# The server also refuses a share when its disk does not have room for it.
# SHARE_MAX_TOTAL_MB=20480

# How many shares may exist at once (default 50). Shares expire after 7 days.
# SHARE_MAX_ACTIVE=50
